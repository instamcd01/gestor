        "path": "catalogo-sync",
        "responseMode": "onReceived",
        "responseCode": 202,
        "options": {
          "rawBody": true
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "id": "w1",

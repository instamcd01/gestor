{
  "name": "iFood - Catalogo Sync",
  "nodes": [
    {
      "parameters": {
        "content": "## Catalogo Sync (iFood)\n\nDisparado pelos triggers trg_notificar_catalogo_produto_canal (preco/disponivel) e trg_notificar_catalogo_estoque (quantidade) via pg_net, sempre que um produto ligado a um marketplace ativo muda.\n\nEnvia para POST /item/v1.0/ingestion/{merchantId} (upsert por barcode). Produtos sem codigo_barras nao disparam o trigger no banco.\n\nO resultado (sucesso ou erro) e gravado de volta em produto_canal.sincronizacao_status para o app mostrar.",
        "height": 300,
        "width": 460
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "id": "sticky1",
      "name": "LEIA-ME",
      "position": [
        -700,
        -380
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "catalogo-sync",
        "responseMode": "onReceived",
        "responseCode": 202,
        "options": {
          "rawBody": true
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "id": "w1",
      "name": "Webhook",
      "position": [
        -700,
        0
      ],
      "webhookId": "a3f0c9e2-5d41-4b7a-9c3e-1f8b6d4a2e70"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select empresa_id, id_loja_plataforma, api_key, api_secret\nfrom empresa_marketplace_config\nwhere empresa_id = $1 and marketplace_id = $2 and ativo = true\nlimit 1;",
        "options": {
          "queryReplacement": "={{ [$json.body.empresa_id, $json.body.marketplace_id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "id": "s2",
      "name": "Buscar credenciais empresa",
      "position": [
        -460,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "GEzDAcb9DFtH5ozo",
          "name": "Postgres cloud"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const empresaId = $json.empresa_id;\nconst store = $getWorkflowStaticData('global');\nstore.ifoodTokens = store.ifoodTokens || {};\nconst cached = store.ifoodTokens[empresaId];\nconst valido = !!(cached && cached.expiresAt > Date.now() + 60000);\nreturn [{\n  json: {\n    ...$json,\n    access_token: valido ? cached.accessToken : null,\n    token_valido: valido,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "s3",
      "name": "Checar token em cache",
      "position": [
        -220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.token_valido}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "id": "s4",
      "name": "Token válido?",
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://merchant-api.ifood.com.br/authentication/v1.0/oauth/token",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "grantType",
              "value": "client_credentials"
            },
            {
              "name": "clientId",
              "value": "={{$json.api_key}}"
            },
            {
              "name": "clientSecret",
              "value": "={{$json.api_secret}}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "id": "s5",
      "name": "Obter token OAuth",
      "position": [
        220,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Checar token em cache').item.json;\nconst store = $getWorkflowStaticData('global');\nstore.ifoodTokens = store.ifoodTokens || {};\nstore.ifoodTokens[ctx.empresa_id] = {\n  accessToken: $json.accessToken,\n  expiresAt: Date.now() + (($json.expiresIn || 21600) * 1000),\n};\nreturn [{\n  json: { ...ctx, access_token: $json.accessToken, token_valido: true },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "s6",
      "name": "Salvar token em cache",
      "position": [
        440,
        120
      ]
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "id": "s7",
      "name": "Token pronto",
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{$('Webhook').item.json.body.marketplace_id}}",
              "rightValue": "d4811153-e210-47b0-b910-ee0440914f60",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "id": "s8",
      "name": "É iFood?",
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "={{ $json.primeiro_envio ? \"POST\" : \"PATCH\" }}",
        "url": "={{ \"https://merchant-api.ifood.com.br/item/v1.0/ingestion/\" + $(\"Buscar credenciais empresa\").item.json.id_loja_plataforma + ($json.primeiro_envio ? \"?reset=false\" : \"\") }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$json.access_token}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ [ { barcode: $('Webhook').item.json.body.codigo_barras, name: $('Webhook').item.json.body.nome, plu: $('Webhook').item.json.body.plu || undefined, active: $('Webhook').item.json.body.disponivel, details: { categorization: { category: $('Webhook').item.json.body.categoria, subCategory: $('Webhook').item.json.body.subcategoria }, brand: $('Webhook').item.json.body.marca, volume: $('Webhook').item.json.body.volume ? String($('Webhook').item.json.body.volume) : undefined, unit: ($('Webhook').item.json.body.unidade_medida || 'UN').toUpperCase(), description: $('Webhook').item.json.body.descricao, imageUrl: $('Webhook').item.json.body.imagem_url || undefined }, prices: { price: $('Webhook').item.json.body.preco, promotionPrice: $('Webhook').item.json.body.preco_promocional || undefined }, inventory: { stock: $('Webhook').item.json.body.estoque }, channels: ['ifood-app'] } ] }}",
        "options": {}
      },
      "onError": "continueErrorOutput",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "id": "c1",
      "name": "Enviar produto para iFood",
      "position": [
        1120,
        -80
      ]
    },

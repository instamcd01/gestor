      "typeVersion": 2,
      "position": [
        1560,
        -140
      ],
      "parameters": {
        "jsCode": "const url = $('Webhook').item.json.body.imagem_url;\nlet imagemBase64 = null;\nif (url) {\n  try {\n    const resp = await this.helpers.httpRequest({ url, encoding: 'arraybuffer', returnFullResponse: true });\n    const contentType = (resp.headers['content-type'] || 'image/jpeg').split(';')[0];\n    const base64 = Buffer.from(resp.body).toString('base64');\n    imagemBase64 = `data:${contentType};base64,${base64}`;\n  } catch (e) {\n    imagemBase64 = null;\n  }\n}\nreturn [{ json: { ...$json, imagem_base64: imagemBase64 } }];"
      }
    },

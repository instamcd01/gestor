{
  "name": "Tool - Consultar Estoque",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "p_produto_id"
            },
            {
              "name": "p_empresa_id"
            },
            {
              "name": "p_quantidade_desejada"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select consultar_estoque($1::uuid, $2::uuid, $3::int) as estoque",
        "options": {
          "queryReplacement": "={{ [ $json.p_produto_id, $json.p_empresa_id, $json.p_quantidade_desejada || null ] }}"
        }
      },
      "id": "consultar-estoque-rpc",
      "name": "Consultar Estoque (RPC)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "GEzDAcb9DFtH5ozo",
          "name": "Postgres cloud"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const row = $input.first()?.json?.estoque || { encontrado: false, disponivel: false, consegue_atender: null };\n// \"quantidade\" nunca sai daqui pro agente: o numero exato de estoque nao deve\n// chegar ao contexto do LLM (ele repetia o numero mesmo com consegue_atender\n// pronto). A RPC ainda calcula quantidade internamente para outros usos futuros\n// (ex: validacao de carrinho direto no banco), so nao trafega para esta tool.\nreturn [{ json: { encontrado: row.encontrado, disponivel: row.disponivel, consegue_atender: row.consegue_atender } }];"
      },
      "id": "montar-resultado",
      "name": "Montar Resultado",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        448,
        0
      ]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [
        [
          {
            "node": "Consultar Estoque (RPC)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar Estoque (RPC)": {
      "main": [
        [
          {
            "node": "Montar Resultado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  }
}

{
  "name": "iFood - Código de Confirmação",
  "nodes": [
    {
      "parameters": {
        "content": "## Código de confirmação (retirada/entrega)\n\nDisparado por UPDATE de pedidos.codigo_confirmacao_valor. Escolhe validatePickupCode (TAKEOUT/INDOOR) ou verifyDeliveryCode (DELIVERY/default) e grava valido/invalido de volta. Sucesso do verifyDeliveryCode marca o pedido como CONCLUDED do lado da iFood automaticamente (não mexe no status local -- o lojista ainda confirma entrega pelo fluxo normal do Gestor).",
        "height": 260,
        "width": 480
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "id": "note",
      "name": "LEIA-ME",
      "position": [
        -260,
        -100
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "codigo-confirmacao",
        "responseMode": "onReceived",
        "responseCode": 202,
        "options": {
          "rawBody": true
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "id": "w1",
      "webhookId": "codigo-confirmacao-webhook",
      "name": "Webhook",
      "position": [
        -260,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select empresa_id, id_loja_plataforma, api_key, api_secret\nfrom empresa_marketplace_config\nwhere empresa_id = $1 and marketplace_id = $2 and ativo = true\nlimit 1;",
        "options": {
          "queryReplacement": "={{ [$json.body.empresa_id, $json.body.marketplace_id] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "id": "a1",
      "name": "Buscar credenciais empresa",
      "position": [
        0,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "GEzDAcb9DFtH5ozo",
          "name": "Postgres cloud"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const empresaId = $json.empresa_id;\nconst store = $getWorkflowStaticData('global');\nstore.ifoodTokensV2 = store.ifoodTokensV2 || {};\nconst cached = store.ifoodTokensV2[empresaId];\nconst valido = !!(cached && cached.expiresAt > Date.now());\nreturn [{\n  json: {\n    ...$json,\n    access_token: valido ? cached.accessToken : null,\n    token_valido: valido,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "a2",
      "name": "Checar token em cache",
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "tk1",
              "leftValue": "={{$json.token_valido}}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "id": "a3",
      "name": "Token válido?",
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://merchant-api.ifood.com.br/authentication/v1.0/oauth/token",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "grantType",
              "value": "client_credentials"
            },
            {
              "name": "clientId",
              "value": "={{$json.api_key}}"
            },
            {
              "name": "clientSecret",
              "value": "={{$json.api_secret}}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "id": "a4",
      "name": "Obter token OAuth",
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Checar token em cache').item.json;\nconst store = $getWorkflowStaticData('global');\nstore.ifoodTokensV2 = store.ifoodTokensV2 || {};\nstore.ifoodTokensV2[ctx.empresa_id] = {\n  accessToken: $json.accessToken,\n  expiresAt: Date.now() + (($json.expiresIn || 21600) * 1000),\n};\nreturn [{\n  json: { ...ctx, access_token: $json.accessToken, token_valido: true },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "a5",
      "name": "Salvar token em cache",
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "id": "a6",
      "name": "Token pronto",
      "position": [
        960,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://merchant-api.ifood.com.br/order/v1.0/orders/{{$('Webhook').item.json.body.marketplace_order_id}}/{{ ['TAKEOUT','INDOOR'].includes($('Webhook').item.json.body.tipo_entrega_marketplace) ? 'validatePickupCode' : 'verifyDeliveryCode' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$json.access_token}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { code: $('Webhook').item.json.body.codigo } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "id": "b1",
      "name": "Validar código na iFood",
      "position": [
        960,
        100
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update pedidos set codigo_confirmacao_status = 'valido', codigo_confirmacao_erro = null where id = $1;",
        "options": {
          "queryReplacement": "={{$('Webhook').item.json.body.pedido_id}}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "id": "b2",
      "name": "Marcar código válido",
      "position": [
        1200,
        -20
      ],
      "credentials": {
        "postgres": {
          "id": "GEzDAcb9DFtH5ozo",
          "name": "Postgres cloud"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update pedidos set codigo_confirmacao_status = 'invalido', codigo_confirmacao_erro = $2 where id = $1;",
        "options": {
          "queryReplacement": "={{ [$('Webhook').item.json.body.pedido_id, $('Validar código na iFood').item.json.error?.message || 'código inválido'] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "id": "b3",
      "name": "Marcar código inválido",
      "position": [
        1200,
        220
      ],
      "credentials": {
        "postgres": {
          "id": "GEzDAcb9DFtH5ozo",
          "name": "Postgres cloud"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Buscar credenciais empresa",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar credenciais empresa": {
      "main": [
        [
          {
            "node": "Checar token em cache",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Checar token em cache": {
      "main": [
        [
          {
            "node": "Token válido?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Token válido?": {
      "main": [
        [
          {
            "node": "Token pronto",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Obter token OAuth",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obter token OAuth": {
      "main": [
        [
          {
            "node": "Salvar token em cache",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Salvar token em cache": {
      "main": [
        [
          {
            "node": "Token pronto",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Token pronto": {
      "main": [
        [
          {
            "node": "Validar código na iFood",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar código na iFood": {
      "main": [
        [
          {
            "node": "Marcar código válido",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Marcar código inválido",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "active": true
}
    {
      "parameters": {
        "jsCode": "const b = $('Webhook').item.json.body;\nconst base = `https://merchant-api.ifood.com.br/order/v1.0/disputes/${b.disputa_id_externo}`;\nlet url, body;\nif (b.status_novo === 'aceita') {\n  url = `${base}/accept`;\n  body = { reason: b.motivo_resposta || 'Aceito pela loja' };\n} else if (b.status_novo === 'alternativa') {\n  // Path e shape inferidos da documentacao, nunca testados contra uma disputa real (nenhuma\n  // aconteceu nesse merchant sandbox ainda). Maior risco: nao sabemos se 'amount.value' e em\n  // centavos ou reais -- o exemplo da doc mostra '\"value\":\"1500\"' sem separador decimal, o que\n  // sugere centavos, mas isso NAO esta confirmado. Conferir com muito cuidado antes de confiar\n  // nisso pra REFUND/BENEFIT reais -- errar aqui e um erro financeiro de 100x, nao cosmetico.\n  url = `${base}/alternatives/${b.alternativa_id_externo}`;\n  if (b.alternativa_tipo === 'ADDITIONAL_TIME') {\n    body = { type: 'ADDITIONAL_TIME', metadata: { additionalTimeInMinutes: b.alternativa_minutos, additionalTimeReason: 'ORDER_OUT_FOR_DELIVERY' } };\n  } else {\n    body = { type: b.alternativa_tipo, metadata: { amount: { value: String(Math.round((b.alternativa_valor || 0) * 100)), currency: 'BRL' } } };\n  }\n} else {\n  url = `${base}/reject`;\n  body = { reason: b.motivo_resposta || 'Rejeitado pela loja' };\n}\nreturn [{ json: { ...$json, url, body } }];"
      },

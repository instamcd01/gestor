    {
      "parameters": {
        "jsCode": "const b = $('Webhook').item.json.body;\nconst info = $json;\nif (b.status_novo === 'alternativa') {\n  // 99Food nao tem esse conceito -- nunca deveria acontecer para uma disputa 99Food.\n  // Deixa passar como recusa (agree:false) em vez de travar o fluxo, mas fica logado.\n  throw new Error('status_novo=alternativa nao suportado pela 99Food (disputa 99Food, deveria ser aceita/rejeitada)');\n}\nconst agree = b.status_novo === 'aceita';\nconst url = info.tipo === 'cancelamento'\n  ? 'https://openapi.99food.com/v1/order/apply/cancel'\n  : 'https://openapi.99food.com/v1/order/apply/refund';\nconst body = {\n  auth_token: info.auth_token,\n  order_id: info.marketplace_order_id,\n  apply_id: b.disputa_id_externo,\n  agree,\n  reason: b.motivo_resposta || (agree ? 'Aceito pela loja' : 'Recusado pela loja'),\n};\nreturn [{ json: { ...info, url, body } }];"
      },

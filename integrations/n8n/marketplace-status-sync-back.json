    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $('Webhook').item.json.body;\nif (body.motivo_cancelamento_codigo) {\n  return [{ json: { ...$('Token pronto').item.json, cancelCodeId: body.motivo_cancelamento_codigo, reason: body.motivo_cancelamento_descricao || body.motivo_cancelamento_codigo } }];\n}\nconst reasons = $input.all().map(i => i.json).filter(r => r && r.cancelCodeId);\nconst preferred = reasons.find(r => r.cancelCodeId === '801') || reasons[0] || { cancelCodeId: '801', description: 'Problemas de sistema na loja' };\nreturn [{ json: { ...$('Token pronto').item.json, cancelCodeId: preferred.cancelCodeId, reason: preferred.description } }];"
      },

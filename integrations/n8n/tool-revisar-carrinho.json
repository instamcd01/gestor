    {
      "parameters": {
        "functionCode": "// Whitelist explicita (regra permanente do projeto) -- reconstroi campo a\n// campo mesmo sendo o retorno ja minimo da RPC.\nconst row = $input.first()?.json?.resultado || {};\nreturn [{ json: {\n  autorizado: !!row.autorizado,\n  aguardando_confirmacao: !!row.aguardando_confirmacao,\n  motivo: row.motivo || null,\n  itens: (row.itens || []).map(i => ({\n    produto_id: i.produto_id, nome: i.nome, quantidade: i.quantidade,\n    preco_unitario: i.preco_unitario, subtotal: i.subtotal,\n  })),\n  subtotal: row.subtotal,\n  frete_disponivel: row.frete_disponivel,\n  valor_frete: row.valor_frete,\n  prazo_estimado_min: row.prazo_estimado_min,\n  total: row.total,\n} }];"
      },
